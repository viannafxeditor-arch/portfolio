# Set only for GitHub Pages. Keep empty for local preview.
VITE_MEDIA_ORIGIN=

# Local-only clients preview. No deployment is performed by enabling this.
VITE_CLIENTS_PREVIEW=true
# Leave empty for the local /api/clients handler. Production needs a backend URL.
VITE_CLIENTS_API_URL=
# Server-only secret. Put the actual value in .env.local, which Git ignores.
# Never rename this variable to VITE_YOUTUBE_API_KEY.
YOUTUBE_API_KEY=
